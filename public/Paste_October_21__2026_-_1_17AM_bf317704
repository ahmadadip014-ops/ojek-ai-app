        // 1. LEAFLET OPENSTREETMAP INITIALIZATION
        function initLeafletMap() {
            // Default Center: Kertosono Square (-7.5925, 112.1008)
            map = L.map('map').setView([-7.5925, 112.1008], 14);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            pickupMarker = L.marker([-7.5925, 112.1008], {draggable: true}).addTo(map).bindPopup("Titik Jemput");
            dropoffMarker = L.marker([-7.5800, 112.1100], {draggable: true}).addTo(map).bindPopup("Titik Tujuan");

            pickupMarker.on('dragend', calculateTariffEstimate);
            dropoffMarker.on('dragend', calculateTariffEstimate);
            calculateTariffEstimate();
        }

        // 2. TARIFF CALCULATION LOGIC
        function calculateTariffEstimate() {
            if (!pickupMarker || !dropoffMarker) return;

            const pLat = pickupMarker.getLatLng();
            const dLat = dropoffMarker.getLatLng();
            
            // Haversine Distance Formula (km)
            const R = 6371;
            const dLatRad = (dLat.lat - pLat.lat) * Math.PI / 180;
            const dLonRad = (dLat.lng - pLat.lng) * Math.PI / 180;
            const a = Math.sin(dLatRad/2) * Math.sin(dLatRad/2) +
                      Math.cos(pLat.lat * Math.PI / 180) * Math.cos(dLat.lat * Math.PI / 180) *
                      Math.sin(dLonRad/2) * Math.sin(dLonRad/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            let distance = R * c;
            if (distance < 0.5) distance = 0.5; // Minimum 0.5 km threshold

            document.getElementById('calc-distance-text').innerText = `Estimasi Jarak: ${distance.toFixed(1)} km`;

            // Tariff Calculation Rule: Rp 6.000 (0-3km), +Rp 2.500/km (>3km), Jastip +Rp 3.000
            let totalOngkir = 0;
            if (distance <= 3) {
                totalOngkir = activeTariff.minTariff;
            } else {
                totalOngkir = activeTariff.minTariff + Math.ceil(distance - 3) * activeTariff.ratePerKm;
            }

            if (selectedService === 'SHOP') {
                totalOngkir += activeTariff.jastipFee;
            }

            totalOngkir = Math.max(0, totalOngkir - activeVoucherDiscount);
            document.getElementById('calc-total-ongkir').innerText = `Rp ${totalOngkir.toLocaleString('id-ID')}`;
        }

